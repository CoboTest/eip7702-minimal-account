# ─────────────────────────────────────────────────────────────
# Core (shared)
# ─────────────────────────────────────────────────────────────

# Target chain id (drives default provider URL derivation)
# Example: 11155111 (Sepolia), 1 (Ethereum mainnet)
CHAIN_ID=11155111

# Ethereum RPC endpoint for the same chain
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<alchemy_api_key>

# Optional overrides when auto mapping is unavailable for your chain
# ENTRYPOINT_V07=
# USDC_ADDRESS=

# Private keys (same format for all): 0x + 64 hex chars
DEPLOYER_PRIVATE_KEY=0x<64_hex_chars>
SPONSOR_PRIVATE_KEY=0x<64_hex_chars>
BUNDLER_PRIVATE_KEY=0x<64_hex_chars>


# ─────────────────────────────────────────────────────────────
# Provider: Pimlico
# ─────────────────────────────────────────────────────────────

# Required
# API key format: pim_...
PIMLICO_API_KEY=pim_<api_key>

# Optional overrides
# Use only if CHAIN_ID->slug mapping does not cover your chain
# PIMLICO_RPC_URL=


# ─────────────────────────────────────────────────────────────
# Provider: Alchemy
# ─────────────────────────────────────────────────────────────

# Required
ALCHEMY_API_KEY=<alchemy_api_key>
# UUID format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ALCHEMY_GAS_POLICY_ID=<policy_uuid>

# Optional overrides
# Use only if CHAIN_ID->network mapping does not cover your chain
# ALCHEMY_RPC_URL=
# Use only if paymaster endpoint differs (default: ALCHEMY_RPC_URL / derived URL)
# ALCHEMY_PAYMASTER_URL=


# ─────────────────────────────────────────────────────────────
# Provider: ZeroDev
# ─────────────────────────────────────────────────────────────

# Required (choose one)
ZERODEV_PROJECT_ID=<project_uuid>
# OR explicit bundler URL
# ZERODEV_BUNDLER_RPC=

# Optional overrides
# Use only if paymaster endpoint differs (default: ZERODEV_BUNDLER_RPC / derived URL)
# ZERODEV_PAYMASTER_RPC=


# ─────────────────────────────────────────────────────────────
# Provider: thirdweb
# ─────────────────────────────────────────────────────────────

# Required (auth: use either or both; backend prefers secret key)
# THIRDWEB_CLIENT_ID format: 32-char lowercase hex
THIRDWEB_CLIENT_ID=<32_hex_client_id>
# THIRDWEB_SECRET_KEY format: fk_...
THIRDWEB_SECRET_KEY=fk_<secret_key>

# Optional overrides
# Default derived from CHAIN_ID: https://<chain_id>.bundler.thirdweb.com/v2
# THIRDWEB_BUNDLER_URL=
# Use only if paymaster endpoint differs (default: THIRDWEB_BUNDLER_URL / derived URL)
# THIRDWEB_PAYMASTER_URL=
