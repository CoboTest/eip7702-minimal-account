# Ethereum Sepolia RPC endpoint
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-key>

# Deployer: deploys MinimalAccount contract (needs ETH for gas)
DEPLOYER_PRIVATE_KEY=0x...

# Sponsor: transfers USDC to Alice (needs ETH + USDC)
SPONSOR_PRIVATE_KEY=0x...

# Bundler: used by self-bundled E2E scripts (needs ETH for gas)
BUNDLER_PRIVATE_KEY=0x...

# Pimlico API key (https://dashboard.pimlico.io)
PIMLICO_API_KEY=pim_...

# Alchemy API key (https://dashboard.alchemy.com)
ALCHEMY_API_KEY=...

# Alchemy Gas Manager policy id (UUID)
ALCHEMY_GAS_POLICY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ZeroDev RPCs (from ZeroDev dashboard)
ZERODEV_BUNDLER_RPC=https://<your-bundler-rpc>.zerodev.app
ZERODEV_PAYMASTER_RPC=https://<your-paymaster-rpc>.zerodev.app

# thirdweb Bundler/Paymaster (see https://portal.thirdweb.com/bundler)
# Preferred: set THIRDWEB_CLIENT_ID and let script auto-build URL as:
#   https://1.rpc.thirdweb.com/<THIRDWEB_CLIENT_ID>
# Optional explicit override:
THIRDWEB_BUNDLER_URL=
# Optional if paymaster endpoint differs (default: THIRDWEB_BUNDLER_URL or auto-built URL)
THIRDWEB_PAYMASTER_URL=
# Auth (prefer secret key for backend)
THIRDWEB_CLIENT_ID=
THIRDWEB_SECRET_KEY=
