# Ethereum Sepolia RPC endpoint
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-key>

# Deployer: deploys MinimalAccount contract (needs ETH for gas)
DEPLOYER_PRIVATE_KEY=0x...

# Sponsor: transfers USDC to Alice (needs ETH + USDC)
SPONSOR_PRIVATE_KEY=0x...

# Bundler: used by self-bundled E2E scripts (needs ETH for gas)
BUNDLER_PRIVATE_KEY=0x...

# Pimlico API key (https://dashboard.pimlico.io)
PIMLICO_API_KEY=pim_...
