# ─────────────────────────────────────────────────────────────
# Core (shared)
# ─────────────────────────────────────────────────────────────

# Ethereum RPC endpoint (example: Sepolia)
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<alchemy_api_key>

# Private keys (same format for all): 0x + 64 hex chars
DEPLOYER_PRIVATE_KEY=0x<64_hex_chars>
SPONSOR_PRIVATE_KEY=0x<64_hex_chars>
BUNDLER_PRIVATE_KEY=0x<64_hex_chars>


# ─────────────────────────────────────────────────────────────
# Provider: Pimlico
# ─────────────────────────────────────────────────────────────

# API key format: pim_...
PIMLICO_API_KEY=pim_<api_key>


# ─────────────────────────────────────────────────────────────
# Provider: Alchemy
# ─────────────────────────────────────────────────────────────

ALCHEMY_API_KEY=<alchemy_api_key>
# UUID format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ALCHEMY_GAS_POLICY_ID=<policy_uuid>


# ─────────────────────────────────────────────────────────────
# Provider: ZeroDev
# ─────────────────────────────────────────────────────────────

# Endpoint format:
# https://rpc.zerodev.app/api/v3/<project_uuid>/chain/<chain_id>
# Required:
ZERODEV_BUNDLER_RPC=https://rpc.zerodev.app/api/v3/<project_uuid>/chain/<chain_id>
# Optional if paymaster endpoint differs (default: ZERODEV_BUNDLER_RPC)
ZERODEV_PAYMASTER_RPC=


# ─────────────────────────────────────────────────────────────
# Provider: thirdweb
# ─────────────────────────────────────────────────────────────

# Bundler URL format: https://<chain_id>.bundler.thirdweb.com/v2
THIRDWEB_BUNDLER_URL=https://<chain_id>.bundler.thirdweb.com/v2
# Optional if paymaster endpoint differs (default: THIRDWEB_BUNDLER_URL)
THIRDWEB_PAYMASTER_URL=

# Auth (use either or both; backend prefers secret key)
# THIRDWEB_CLIENT_ID format: 32-char lowercase hex
THIRDWEB_CLIENT_ID=<32_hex_client_id>
# THIRDWEB_SECRET_KEY format: fk_...
THIRDWEB_SECRET_KEY=fk_<secret_key>
